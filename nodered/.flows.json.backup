    {
        "id": "koekken_mqtt_in",
        "type": "mqtt in",
        "z": "ced8b8b6adb174ea",
        "name": "Køkken temp/fugt",
        "topic": "zigbee2mqtt/Køkken",
        "qos": "1",
        "datatype": "json",
        "broker": "opvask_mqtt_broker",
        "inputs": 0,
        "x": 200,
        "y": 460,
        "wires": [
            [
                "koekken_influx_func"
            ]
        ]
    },
    {
        "id": "koekken_influx_func",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Byg InfluxDB line protocol",
        "func": "const data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n\nconst fields = [];\nif (data.temperature !== undefined) fields.push(`temperature=${data.temperature}`);\nif (data.humidity !== undefined) fields.push(`humidity=${data.humidity}`);\nif (data.pressure !== undefined) fields.push(`pressure=${data.pressure}`);\nif (data.battery !== undefined) fields.push(`battery=${data.battery}`);\nif (data.linkquality !== undefined) fields.push(`linkquality=${data.linkquality}`);\n\nif (fields.length === 0) {\n    return [null, null, null];\n}\n\n// Cache seneste måling globalt, så Telegram-kommandoen \"køkken\" kan svare\n// øjeblikkeligt uden at skulle spørge InfluxDB\nconst seneste = global.get('koekken_seneste') || {};\nif (data.temperature !== undefined) seneste.temperature = data.temperature;\nif (data.humidity !== undefined) seneste.humidity = data.humidity;\nif (data.battery !== undefined) seneste.battery = data.battery;\nseneste.opdateret = new Date().toISOString();\nglobal.set('koekken_seneste', seneste);\n\nconst line = `temperatur_fugt,sted=koekken ${fields.join(',')}`;\n\nconst influxMsg = {\n    url: 'http://influxdb:8086/api/v2/write?org=energihub&bucket=energi2&precision=s',\n    method: 'POST',\n    headers: {\n        'Content-Type': 'text/plain; charset=utf-8',\n        'Authorization': `Token ${env.get('INFLUX_TOKEN')}`\n    },\n    payload: line\n};\n\n// Batteri-advarsel: kun besked ved SKIFT i status, ikke ved hver måling\nlet telegramMsg = null;\nlet eventMsg = null;\n\nif (data.battery !== undefined) {\n    let batteriStatus = 'normal';\n    if (data.battery <= 1) batteriStatus = 'kritisk';\n    else if (data.battery <= 5) batteriStatus = 'lavt';\n\n    const sidsteBatteriStatus = global.get('koekken_batteri_status') || 'normal';\n\n    if (batteriStatus !== sidsteBatteriStatus) {\n        global.set('koekken_batteri_status', batteriStatus);\n\n        if (batteriStatus === 'kritisk') {\n            telegramMsg = { payload: `🔴 <b>Kritisk lavt batteri!</b>\\n\\nKøkken-sensoren er nede på ${data.battery}% batteri - skift det snart!` };\n            eventMsg = { payload: { event: 'alarm', beskrivelse: `🔴 Køkken-sensor kritisk lavt batteri: ${data.battery}%` } };\n        } else if (batteriStatus === 'lavt') {\n            telegramMsg = { payload: `🟡 <b>Lavt batteri</b>\\n\\nKøkken-sensoren har ${data.battery}% batteri tilbage - husk at skifte det snart.` };\n            eventMsg = { payload: { event: 'alarm', beskrivelse: `🟡 Køkken-sensor lavt batteri: ${data.battery}%` } };\n        } else if (sidsteBatteriStatus !== 'normal') {\n            telegramMsg = { payload: `🔋 Køkken-sensor batteri normaliseret: ${data.battery}%` };\n        }\n    }\n}\n\nreturn [influxMsg, telegramMsg, eventMsg];",
        "outputs": 3,
        "noerr": 0,
        "x": 440,
        "y": 460,
        "wires": [
            [
                "koekken_influx_write"
            ],
            [
                "telegram-send"
            ],
            []
        ]
    },
    {
        "id": "koekken_influx_write",
        "type": "http request",
        "z": "ced8b8b6adb174ea",
        "name": "Skriv til InfluxDB",
        "method": "use",
        "ret": "txt",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "x": 670,
