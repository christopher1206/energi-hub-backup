        ]
    },
    {
        "id": "koekken_api_in",
        "type": "http in",
        "z": "ced8b8b6adb174ea",
        "name": "Køkken sensor API",
        "url": "/api/koekken-sensor",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 200,
        "y": 520,
        "wires": [
            [
                "koekken_api_handler"
            ]
        ]
    },
    {
        "id": "koekken_api_handler",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Byg Flux-forespørgsel",
        "func": "const flux = `\nfrom(bucket: \"energi2\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"temperatur_fugt\" and r.sted == \"koekken\")\n  |> group(columns: [\"_field\"])\n  |> last()\n`;\n\nmsg.url = 'http://influxdb:8086/api/v2/query?org=energihub';\nmsg.method = 'POST';\nmsg.headers = {\n    'Content-Type': 'application/vnd.flux',\n    'Accept': 'application/csv',\n    'Authorization': `Token ${env.get('INFLUX_TOKEN')}`\n};\nmsg.payload = flux;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 440,
        "y": 520,
        "wires": [
            [
                "koekken_influx_query"
            ]
        ]
    },
    {
        "id": "koekken_influx_query",
        "type": "http request",
        "z": "ced8b8b6adb174ea",
        "name": "Spørg InfluxDB",
        "method": "use",
        "ret": "txt",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "x": 670,
        "y": 520,
        "wires": [
            [
                "koekken_parse_csv"
            ]
        ]
    },
    {
        "id": "koekken_parse_csv",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Parse CSV-svar",
        "func": "const csv = msg.payload || '';\nconst lines = csv.trim().split(/\\r?\\n/).filter(l => l.length > 0 && !l.startsWith('#'));\n\nconst resultat = {\n    temperature: null,\n    humidity: null,\n    battery: null,\n    linkquality: null,\n    timestamp: null\n};\n\nlet headerIdx = null;\nfor (const line of lines) {\n    const cols = line.split(',').map(c => c.trim());\n    const fieldIdx = cols.indexOf('_field');\n    if (fieldIdx !== -1) {\n        headerIdx = cols;\n        continue;\n    }\n    if (headerIdx) {\n        const fieldNavn = cols[headerIdx.indexOf('_field')];\n        const value = parseFloat(cols[headerIdx.indexOf('_value')]);\n        const tid = cols[headerIdx.indexOf('_time')];\n        if (fieldNavn in resultat && !isNaN(value)) {\n            resultat[fieldNavn] = value;\n            resultat.timestamp = tid;\n        }\n    }\n}\n\nmsg.payload = resultat;\nmsg.headers = { 'Content-Type': 'application/json' };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 900,
        "y": 520,
        "wires": [
            [
                "koekken_api_svar"
            ]
        ]
    },
    {
        "id": "koekken_api_svar",
        "type": "http response",
        "z": "ced8b8b6adb174ea",
        "name": "Køkken sensor svar",
        "statusCode": "",
        "headers": {},
        "x": 1130,
        "y": 520,
        "wires": []
    },
    {
        "id": "opvask_mqtt_in",
        "type": "mqtt in",
        "z": "opvask_tab",
        "name": "Shelly opvaskemaskine status",
        "topic": "shellyplugsg3-d885ac1c3514/status/switch:0",
        "qos": "0",
        "datatype": "auto",
        "broker": "opvask_mqtt_broker",
        "inputs": 0,
        "x": 220,
