    {
        "id": "depot_sensor_batteri_func",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Depotsensor batteri-tjek",
        "func": "const data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n\nif (data.battery === undefined) {\n    return [null, null, null];\n}\n\nlet batteriStatus = 'normal';\nif (data.battery <= 1) batteriStatus = 'kritisk';\nelse if (data.battery <= 5) batteriStatus = 'lavt';\n\nconst sidsteBatteriStatus = global.get('depot_sensor_batteri_status') || 'normal';\n\nlet telegramMsg = null;\nlet eventMsg = null;\n\nif (batteriStatus !== sidsteBatteriStatus) {\n    global.set('depot_sensor_batteri_status', batteriStatus);\n\n    const headers = {\n        'Content-Type': 'text/plain; charset=utf-8',\n        'Authorization': `Token ${env.get('INFLUX_TOKEN')}`\n    };\n    const url = 'http://influxdb:8086/api/v2/write?org=energihub&bucket=energi2&precision=s';\n\n    if (batteriStatus === 'kritisk') {\n        telegramMsg = { payload: `🔴 <b>Kritisk lavt batteri!</b>\\n\\nDepotsensoren er nede på ${data.battery}% batteri - skift det snart!` };\n        eventMsg = { url, method: 'POST', headers, payload: `events,type=alarm value=\"🔴 Depotsensor kritisk lavt batteri: ${data.battery}%\"` };\n    } else if (batteriStatus === 'lavt') {\n        telegramMsg = { payload: `🟡 <b>Lavt batteri</b>\\n\\nDepotsensoren har ${data.battery}% batteri tilbage - husk at skifte det snart.` };\n        eventMsg = { url, method: 'POST', headers, payload: `events,type=alarm value=\"🟡 Depotsensor lavt batteri: ${data.battery}%\"` };\n    } else if (sidsteBatteriStatus !== 'normal') {\n        telegramMsg = { payload: `🔋 Depotsensor batteri normaliseret: ${data.battery}%` };\n    }\n}\n\nreturn [telegramMsg, eventMsg];",
        "outputs": 2,
        "noerr": 0,
        "x": 440,
        "y": 500,
        "wires": [
            [
                "telegram-send"
            ],
            [
                "depot_sensor_batteri_influx_write"
            ]
        ]
    },
