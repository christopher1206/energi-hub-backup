    {
        "id": "aa99c999295283cc",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Byg rapport fra API",
        "func": "const data = msg.payload;\nconst soc = global.get('batteri_soc') || 0;\nconst carSoc = global.get('car_soc') || 50;\nconst vejrTekst = global.get('vejr_tekst') || 'ukendt';\nconst vejrMin = global.get('vejr_temp_min') || '?';\nconst vejrMax = global.get('vejr_temp_max') || '?';\n\nif (!data || data.fejl) {\n    msg.payload = '📊 <b>Daglig rapport</b>\\n\\nKunne ikke hente data fra API';\n    return msg;\n}\n\nmsg.payload = '📊 <b>Daglig energi rapport</b>\\n\\n' +\n    '☀️ Sol produceret: ' + data.dagens_sol_kwh + ' kWh\\n' +\n    '🔌 Købt fra net: ' + data.dagens_grid_kob_kwh + ' kWh (' + data.dagens_grid_kob_kr + ' kr)\\n' +\n    '📤 Solgt til net: ' + data.dagens_grid_solgt_kwh + ' kWh\\n' +\n    '⬆️ Batteri ladet: ' + data.dagens_batteri_ind_kwh + ' kWh\\n' +\n    '⬇️ Batteri afladet: ' + data.dagens_batteri_ud_kwh + ' kWh\\n' +\n    '🚗 Tesla ladet: ' + data.dagens_tesla_kwh + ' kWh\\n' +\n    '💰 Sparet i dag: ' + data.sparet_i_dag + ' kr\\n' +\n    '📊 Selvforsyning: ' + data.selvforsyning_i_dag + '%\\n\\n' +\n    '🔋 Growatt nu: ' + soc + '%\\n' +\n    '🚗 King kong: ' + carSoc + '%\\n' +\n    '🌤️ Vejr: ' + vejrTekst + ' ' + vejrMin + '-' + vejrMax + '°C';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
