    {
        "id": "override-handler",
        "type": "function",
        "z": "d2c1c437030fcf3d",
        "name": "Override handler",
        "func": "const aktiv = msg.payload.aktiv;\nlet eventMsg = null;\n\nif (aktiv) {\n    global.set('override_aktiv', true);\n    global.set('override_slut', null);\n    node.warn(`\\ud83d\\udea8 OVERRIDE AKTIV - k\\u00f8rer indtil manuelt stop!`);\n    msg.payload = { success: true, besked: 'Override aktiv indtil manuelt stop' };\n    eventMsg = { payload: { event: 'override', beskrivelse: '\\ud83d\\udea8 Manuel override aktiveret - Tesla tvinges til 16A' } };\n} else {\n    global.set('override_aktiv', false);\n    global.set('override_slut', null);\n    node.warn('\\u2705 Override deaktiveret');\n    msg.payload = { success: true, besked: 'Override deaktiveret' };\n    eventMsg = { payload: { event: 'override', beskrivelse: '\\u2705 Manuel override deaktiveret' } };\n}\n\n// Trigger Beslutnings-motor med det samme, uanset t\\u00e6nd/sluk,\n// i stedet for at vente p\\u00e5 n\\u00e6ste 5-minutters cyklus\nconst triggerMsg = { payload: {} };\n\nreturn [msg, eventMsg, triggerMsg];\n",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
