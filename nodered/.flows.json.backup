    {
        "id": "go-e-status-gem",
        "type": "function",
        "z": "d2c1c437030fcf3d",
        "name": "Gem go-e status",
        "func": "const car = msg.payload.car || 0;\nconst amp = msg.payload.amp || 0;\nconst wh = msg.payload.wh || 0;\n\nconst sidsteWh = global.get('go_e_wh_sidste') || 0;\nconst akkumuleret = global.get('car_charged_wh_akkumuleret') || 0;\n\nlet nytAkkumuleret = akkumuleret;\nif (wh >= sidsteWh) {\n    nytAkkumuleret += (wh - sidsteWh);\n} else {\n    nytAkkumuleret += wh;\n}\n\nglobal.set('go_e_wh_sidste', wh);\nglobal.set('car_charged_wh_akkumuleret', nytAkkumuleret);\nglobal.set('go_e_car', car);\nglobal.set('go_e_amp', amp);\nglobal.set('go_e_wh', wh);\n\nnode.warn(`go-e: car=${car} amp=${amp}A wh=${wh} akkumuleret_siden_sidste_opdatering=${nytAkkumuleret}Wh`);\n\n// Log tilsluttet/afbrudt som begivenhed, kun ved faktisk skift i status\nconst tilsluttet = car > 1;\nconst sidsteTilsluttet = global.get('sidste_bil_tilsluttet');\nlet eventMsg = null;\nif (sidsteTilsluttet !== tilsluttet) {\n    global.set('sidste_bil_tilsluttet', tilsluttet);\n    eventMsg = {\n        payload: {\n            event: 'bil_tilslutning',\n            beskrivelse: tilsluttet ? '🔌 Bil tilsluttet opladeren' : '🔌 Bil afbrudt fra opladeren'\n        }\n    };\n    node.warn(`📝 Event: Bil ${tilsluttet ? 'tilsluttet' : 'afbrudt'}`);\n}\n\nreturn [null, eventMsg];",
        "outputs": 2,
        "x": 980,
        "y": 520,
        "wires": [
            [],
            [
                "gem-event"
            ]
        ]
    },
    {
        "id": "gem-event",
        "type": "function",
        "z": "d2c1c437030fcf3d",
        "name": "Gem event til InfluxDB",
        "func": "const event = msg.payload.event;\nconst beskrivelse = msg.payload.beskrivelse;\n\nif (!event) return null;\n\nconst lineProtocol = `events,type=${event.replace(/ /g,'_')} beskrivelse=\"${beskrivelse}\"`;\n\nmsg.payload = lineProtocol;\nmsg.headers = {\n    'Authorization': 'Token ' + env.get('INFLUX_TOKEN'),\n    'Content-Type': 'text/plain'\n};\nmsg.url = 'http://192.168.1.253:8086/api/v2/write?org=energihub&bucket=energi2&precision=s';\nreturn msg;",
        "outputs": 1,
