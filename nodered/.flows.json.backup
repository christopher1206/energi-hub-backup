    {
        "id": "beslutning-timer",
        "type": "inject",
        "z": "d2c1c437030fcf3d",
        "name": "Kør hvert 5. sekund",
        "repeat": "5",
        "crontab": "",
        "once": true,
        "onceDelay": 5,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 130,
        "y": 60,
        "wires": [
            [
                "beslutnings-motor"
            ]
        ]
    },
    {
        "id": "beslutnings-motor",
        "type": "function",
        "z": "d2c1c437030fcf3d",
        "name": "Beslutnings-motor",
        "func": "// Tjek override FØRST - kører indtil manuelt stop\nconst overrideAktiv = global.get('override_aktiv') || false;\n\nif (overrideAktiv) {\n    const soc = global.get('batteri_soc') || 0;\n    const sol = global.get('sol_power') || 0;\n    const grid = global.get('grid_power') || 0;\n    node.warn(`🚨 OVERRIDE AKTIV! Tvinger Tesla ladning til 16A`);\n    msg.payload = {\n        growattMode: 'load_first',\n        teslaLad: true,\n        teslaAmp: 16,\n        soc, sol, grid,\n        pris: 0,\n        zone: 'override',\n        beslutning: ['🚨 MANUEL OVERRIDE AKTIV']\n    };\n    return msg;\n}\n\n// Hent aktuelle værdier\nconst soc = global.get('batteri_soc') || 0;\nconst sol = global.get('sol_power') || 0;\nconst grid = global.get('grid_power') || 0;\nconst batteriPower = global.get('batteri_power') || 0;\nconst temp = global.get('batteri_temp') || 0;\nconst nuvaerende = global.get('nuvaerende');\nconst priser = global.get('priser') || [];\nconst loadPower = global.get('load_power') || 0;\n\nif (!nuvaerende) {\n    node.warn('⚠️ Ingen prisdata endnu - afventer');\n    return null;\n}\n\n// Batteri grænser\nconst GROWATT_MIN_SOC = 10;\nconst GROWATT_AFLAD_MIN = 50;\nconst TESLA_MAL = 100;\nconst TESLA_KWH = 60;\nconst TESLA_MAX_KW = 11;\nconst SOL_GRAENSE = 200;\nconst TESLA_MIN_OVERSKUD = 4140; // 3-faset minimum: 6A x 690W\nconst DEADLINE_TIME = 6; // Bilen skal være klar kl. 06:00 hver dag\n\nconst pris = nuvaerende.pris;\nconst zone = nuvaerende.zone;\nconst nu = new Date();\nconst time = nu.getHours();\nconst erDyrAften = time >= 16 && time < 21;\nconst erSol = sol > SOL_GRAENSE;\n\n// Sol overskud efter husforbrug\nconst solEfterHus = sol - loadPower;\nconst erSolOverskud = solEfterHus > TESLA_MIN_OVERSKUD;\n\n// Bilens behov\nconst carSoc = global.get('car_soc') || 50;\nconst goECar = global.get('go_e_car') || 1;\nconst bilTilsluttet = goECar > 1;\nconst manglerKwh = Math.max(0, (TESLA_MAL - carSoc) * (TESLA_KWH / 100));\nconst timerNodvendige = Math.ceil(manglerKwh / TESLA_MAX_KW);\n\n// Beregn deadline-tidspunkt (næste forekomst af DEADLINE_TIME)\nconst deadline = new Date(nu);\ndeadline.setHours(DEADLINE_TIME, 0, 0, 0);\nif (deadline <= nu) {\n    deadline.setDate(deadline.getDate() + 1);\n}\n\n// Find prispunkter FRA START AF DENNE TIME og frem til deadline.\n// VIGTIGT: Bruger starten af nuværende time (ikke det præcise \"nu\"-tidspunkt),\n// ellers bliver den time vi rent faktisk står i altid ekskluderet som kandidat\n// (fordi timens tidsstempel, fx 22:00:00, altid ligger FØR \"nu\", fx 22:53) -\n// det betød at automatisk ladning ALDRIG kunne starte i den billigste time,\n// kun i timer der blev udpeget en time i forvejen.\nconst timeStart = new Date(nu);\ntimeStart.setMinutes(0, 0, 0);\n\nconst kommendeTilDeadline = priser.filter(p => {\n    const t = new Date(p.time);\n    return t >= timeStart && t <= deadline;\n});\n\n// Vælg de N billigste timer ud af dem, hvor N = timerNodvendige (mindst 1 hvis bilen mangler noget)\nconst billigsteTimerFuld = [...kommendeTilDeadline]\n    .sort((a, b) => a.pris - b.pris)\n    .slice(0, Math.max(timerNodvendige, 1))\n    .sort((a, b) => new Date(a.time) - new Date(b.time));\n\nconst billigsteTimer = billigsteTimerFuld.map(p => new Date(p.time).getHours());\n\nglobal.set('ladeplan', {\n    timer: billigsteTimerFuld.map(p => ({ time: p.time, pris: p.pris })),\n    manglerKwh: manglerKwh,\n    timerNodvendige: timerNodvendige,\n    bilTilsluttet: bilTilsluttet,\n    carSoc: carSoc,\n    deadline: deadline.toISOString()\n});\n\nconst erBilligTeslaTime = billigsteTimer.includes(time);\n\n// Tving Tesla hvis vi er inde i den udvalgte ladeperiode og tæt på deadline\n// (sikkerhedsnet hvis prislogikken af en grund ikke rammer rigtigt)\nconst timerTilDeadline = (deadline.getTime() - nu.getTime()) / (1000 * 60 * 60);\nconst maxKwhResterende = timerTilDeadline * TESLA_MAX_KW;\nlet tvingTesla = false;\nif (bilTilsluttet && maxKwhResterende < manglerKwh && manglerKwh > 0) {\n    tvingTesla = true;\n    node.warn(`⚠️ Tesla kan ikke nå ${TESLA_MAL}% før ${DEADLINE_TIME}:00! Mangler ${manglerKwh.toFixed(1)} kWh, kun ${maxKwhResterende.toFixed(1)} kWh tid tilbage`);\n}\n\n// BESLUTNINGER\nlet growattMode = 'load_first'; // DEFAULT altid load first\nlet dischargeMode = 'normal';   // normal = kun aflade hvis dyr tid\nlet teslaLad = false;\nlet teslaAmp = 0;\nlet beslutning = [];\n\n// REGEL 1: Discharge styres nu UDELUKKENDE af klokkeslæt (før/efter 16:00).\n// Growatt kører altid Load First - Tesla-ladning (REGEL 8 nedenfor) kan\n// stadig tvinge afladning til at stoppe uanset klokkeslæt.\ngrowattMode = 'load_first';\n\nif (time >= 16) {\n    dischargeMode = 'aktiv';\n    beslutning.push(`🌆 Efter kl. 16 (${pris} kr) → Load first, afladning tilladt (100%)`);\n} else {\n    dischargeMode = 'stop';\n    beslutning.push(`🌅 Før kl. 16 (${pris} kr) → Load first, afladning forhindret (0%)`);\n}\n\n// Morgen-failsafe kl. 07:00 - eksplicit logbesked (funktionelt allerede dækket\n// af tidsreglen ovenfor, da 07:00 < 16:00, men logges separat til synlighed)\nconst idagStrFailsafe = nu.toLocaleDateString('en-GB', { timeZone: 'Europe/Copenhagen' });\nconst sidsteFailsafeDag = flow.get('morgen_failsafe_dag');\nif (time === 7 && sidsteFailsafeDag !== idagStrFailsafe) {\n    flow.set('morgen_failsafe_dag', idagStrFailsafe);\n    node.warn('🌅 Morgen-failsafe kl. 07:00: bekræfter afladning er 0%');\n}\n\n// TESLA-LADEBESLUTNING: helt uafhængig af Growatt-tilstand og om solen skinner.\n// Afgøres UDELUKKENDE af om grid-prisen er billig lige nu - dag som nat,\n// hverdag som weekend. Eneste faste undtagelse er dyr aftentid (16-21),\n// som aldrig tillader ladning fra nettet uanset prisz one.\nif (zone === 'billig') {\n    if (bilTilsluttet && carSoc < 100 && erBilligTeslaTime) {\n        teslaLad = true;\n        teslaAmp = 16;\n        beslutning.push(`🚗 Tesla lader mod deadline ${DEADLINE_TIME}:00 (${pris} kr/kWh, grid billig, ${carSoc}% → 100%, mangler ${manglerKwh.toFixed(1)} kWh)`);\n    } else if (bilTilsluttet && carSoc >= 100) {\n        beslutning.push(`🚗 Tesla allerede fuldt opladet (${carSoc}%)`);\n    } else if (!bilTilsluttet) {\n        beslutning.push(`🚗 Tesla ikke tilsluttet - springer billig ladning over`);\n    }\n}\n\n// REGEL 5: Sol overskud → lad Tesla (kun hvis Growatt 100%)\nif (erSolOverskud && soc >= 100) {\n    const teslaAmpBeregnet = Math.floor(solEfterHus / 690); // 3-faset: 1A = 3x230V = 690W\n    if (teslaAmpBeregnet >= 6) {\n        teslaLad = true;\n        teslaAmp = Math.min(16, teslaAmpBeregnet);\n        beslutning.push(`☀️ Growatt 100% + Sol overskud ${solEfterHus}W → Tesla ${teslaAmp}A`);\n    } else {\n        beslutning.push(`☀️ Sol overskud ${solEfterHus}W → For lidt til Tesla (min 6A 3-faset = 4140W)`);\n    }\n} else if (erSol && soc < 100) {\n    beslutning.push(`🔋 Growatt ${soc}% → Sol lader batteri først, Tesla venter`);\n}\n\n// REGEL 6: Tving Tesla hvis deadline er i fare - tæller over ALLE dage, ikke kun hverdage\nif (tvingTesla) {\n    teslaLad = true;\n    teslaAmp = 16;\n    beslutning.push(`🚨 DEADLINE ${DEADLINE_TIME}:00! Tesla tvinges til 16A`);\n}\n\n// REGEL 7: Batteri for varm → advar\nif (temp > 45) {\n    beslutning.push(`🌡️ Growatt batteri for varm (${temp}°C)!`);\n}\n\n// REGEL 8: Tesla lader → stop batteri-afladning\n// Der er allerede billig grid-strøm (eller solcelle-overskud) til at dække\n// ladningen, så batteriet skal ikke ALSO tømmes samtidig - det ville bare\n// spilde battericapacitet vi kan få bedre brug for senere.\nif (teslaLad) {\n    if (dischargeMode !== 'stop') {\n        beslutning.push(`🔋 Tesla lader → batteri-afladning stoppet (sparer batteriet)`);\n    }\n    dischargeMode = 'stop';\n}\n\n// Gem beslutning globalt\nglobal.set('growatt_mode', growattMode);\nglobal.set('discharge_mode', dischargeMode);\nglobal.set('tesla_lad', teslaLad);\nglobal.set('tesla_amp', teslaAmp);\n\nnode.warn(`📊 Growatt: ${soc}% | Sol: ${sol}W | Hus: ${loadPower}W | Overskud: ${solEfterHus}W | Net: ${grid}W | Pris: ${pris} kr (${zone}) | Bil: ${bilTilsluttet ? carSoc + '% (mangler ' + manglerKwh.toFixed(1) + ' kWh, behov ' + timerNodvendige + 'h)' : 'ikke tilsluttet'} | ${erDyrAften ? '🔴 DYR AFTEN' : erSol ? '☀️ SOL' : '🌙 NAT'}`);\nbeslutning.forEach(b => node.warn(b));\n\nmsg.payload = { growattMode, dischargeMode, teslaLad, teslaAmp, soc, sol, grid, pris, zone, beslutning };\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 150,
        "y": 160,
        "wires": [
            [
                "udfør-tesla",
                "growatt-styring"
            ]
        ]
    },
    {
        "id": "udfør-tesla",
        "type": "function",
        "z": "d2c1c437030fcf3d",
        "name": "Styr go-e lader",
        "func": "const teslaLad = msg.payload.teslaLad;\nconst teslaAmp = msg.payload.teslaAmp;\n\nlet goeMsg = { ...msg };\nif (teslaLad) {\n    goeMsg.url = `http://192.168.1.222/api/set?frc=2&amp=${teslaAmp}`;\n    node.warn(`🚗 go-e: Lader ${teslaAmp}A`);\n} else {\n    goeMsg.url = `http://192.168.1.222/api/set?frc=1`;\n    node.warn(`🚗 go-e: STOP ladning`);\n}\n\n// Log event kun ved SKIFT i ladestatus, ikke ved hver 5-min tjek\nconst sidsteTeslaLad = global.get('sidste_tesla_lad');\nlet eventMsg = null;\nif (sidsteTeslaLad !== teslaLad) {\n    global.set('sidste_tesla_lad', teslaLad);\n    eventMsg = {\n        payload: {\n            event: 'tesla_ladning',\n            beskrivelse: teslaLad\n                ? `🚗 Tesla ladning startet (${teslaAmp}A)`\n                : `🚗 Tesla ladning stoppet`\n        }\n    };\n    node.warn(`📝 Event: Tesla ladning ${teslaLad ? 'startet' : 'stoppet'}`);\n}\n\nreturn [goeMsg, eventMsg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 120,
        "wires": [
            [
                "go-e-http"
            ],
            [
                "gem-event"
            ]
        ]
    },
    {
        "id": "go-e-http",
        "type": "http request",
        "z": "d2c1c437030fcf3d",
        "name": "go-e API",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 620,
        "y": 60,
        "wires": [
            []
        ]
    },
    {
        "id": "growatt-styring",
        "type": "function",
        "z": "d2c1c437030fcf3d",
        "name": "Growatt kommando",
        "func": "const GROWATT_MIN_SOC = 10;\nconst growattMode = msg.payload.growattMode;\nconst dischargeMode = msg.payload.dischargeMode; // 'aktiv' eller 'stop', fra Beslutnings-motor\nconst soc = msg.payload.soc;\nconst time = new Date().getHours();\n\n// ALTID Load first\nconst workMode = 'Load first';\n\n// Discharge logik - bruger nu Beslutnings-motorens FAKTISKE beslutning\n// (som allerede tager højde for pris, sol, og om Tesla lader), i stedet for\n// en separat tidsregel der kunne komme ud af trit med den ægte beslutning.\nlet dischargeRate = 0;\nlet dischargeAarsag = '';\n\nif (soc <= GROWATT_MIN_SOC) {\n    dischargeRate = 0;\n    dischargeAarsag = `Batteri for lavt (${soc}%)`;\n    node.warn(`🔋 Batteri for lavt (${soc}%) → Ingen afladning`);\n} else if (dischargeMode === 'aktiv') {\n    dischargeRate = 100;\n    dischargeAarsag = `Beslutnings-motor: afladning aktiv (${time}:00)`;\n    node.warn(`🔋 Afladning aktiv (${time}:00) → 100%`);\n} else {\n    dischargeRate = 0;\n    dischargeAarsag = `Beslutnings-motor: afladning stoppet (${time}:00)`;\n    node.warn(`🔋 Afladning stoppet (${time}:00) → 0%`);\n}\n\nglobal.set('growatt_kommando', workMode);\nglobal.set('discharge_rate', dischargeRate);\n\nnode.warn(`⚡ Growatt: ${workMode} | Discharge: ${dischargeRate}%`);\n\n// Log event hvis discharge ændret sig\nconst sidsteDischarge = global.get('sidste_discharge_rate');\nlet eventMsg = null;\n\nif (sidsteDischarge !== dischargeRate) {\n    global.set('sidste_discharge_rate', dischargeRate);\n    eventMsg = {\n        payload: {\n            event: 'discharge_skift',\n            beskrivelse: `Discharge ${sidsteDischarge !== undefined ? sidsteDischarge : '?'}% → ${dischargeRate}% (${dischargeAarsag})`\n        }\n    };\n    node.warn(`📝 Event: Discharge skift ${sidsteDischarge}% → ${dischargeRate}%`);\n}\n\nmsg.payload = workMode;\nmsg.topic = 'solar_assistant/inverter_1/work_mode_priority/set';\n\nmsg.discharge = {\n    payload: dischargeRate.toString(),\n    topic: 'solar_assistant/inverter_1/free_mode_discharge_rate/set'\n};\n\nreturn [msg, eventMsg];",
