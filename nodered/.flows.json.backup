    {
        "id": "uge_status_byg",
        "type": "function",
        "z": "sol_lys_tab",
        "name": "Byg statusbesked",
        "func": "const d = msg.payload;\nif (!d || d.fejl) {\n    node.warn('⚠️ Kunne ikke hente måned-statistik til ugentlig status');\n    return null;\n}\n\nconst nu = new Date();\nconst maanedNavn = nu.toLocaleDateString('da-DK', { timeZone: 'Europe/Copenhagen', month: 'long' });\n\nconst tekst = `📊 <b>Ugentlig status - ${maanedNavn}</b>\n\n☀️ Sol produceret: <b>${d.sol_kwh} kWh</b>\n🏠 Husforbrug: <b>${d.load_kwh} kWh</b>\n\n🔌 Købt fra net: ${d.grid_kob_kwh} kWh - <b>${d.grid_kob_kr} kr</b>\n📤 Solgt til net: ${d.grid_solgt_kwh} kWh - <b>${d.grid_solgt_kr} kr</b>\n\n🚗 Tesla ladet: <b>${d.tesla_kwh} kWh</b>\n\n📈 Selvforsyningsgrad: ${d.selvforsyning}%\n💰 Nettoresultat: <b>${(d.grid_solgt_kr - d.grid_kob_kr).toFixed(2)} kr</b>\n\n🌡️ Køkken denne måned: ${d.koekken_temp_gennemsnit ?? '–'}°C snit (${d.koekken_temp_min ?? '–'}-${d.koekken_temp_max ?? '–'}°C)`;\n\nmsg.payload = tekst;\nmsg.kilde = 'uge_status';\nmsg.idagStr = msg.idagStr;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 960,
        "y": 460,
        "wires": [
            []
        ]
    },
    {
        "id": "udendors_mqtt_in",
        "type": "mqtt in",
        "z": "udendors_lys_tab",
        "name": "Zigbee udendørs lys status",
        "topic": "zigbee2mqtt/+",
        "qos": "0",
        "datatype": "auto",
        "broker": "opvask_mqtt_broker",
        "nl": false,
        "rap": false,
        "inputs": 0,
        "x": 220,
        "y": 100,
        "wires": [
            [
                "udendors_function"
            ]
        ]
    },
    {
        "id": "udendors_function",
        "type": "function",
        "z": "udendors_lys_tab",
        "name": "Byg InfluxDB line protocol",
        "func": "const data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n\nif (data.state === undefined) {\n    return null;\n}\n\nconst sted = msg.topic.split('/')[1];\n\n// Kun de faktiske udendørs-lamper - MQTT-emnet 'zigbee2mqtt/+' fanger ALLE\n// Zigbee-enheder (inkl. Depotlys m.fl.), så vi filtrerer eksplicit her for\n// at undgå at andre enheder fejlagtigt logges som udendørs lys-hændelser.\nif (sted !== 'lys_carport' && sted !== 'lys_terrasse') {\n    return null;\n}\n\nconst stedNavn = sted === 'lys_carport' ? 'Carport' : 'Terrasse';\n\nconst stateVal = data.state === 'ON' ? 1 : 0;\nconst fields = [];\nfields.push(`state=${stateVal}`);\nif (data.brightness !== undefined) fields.push(`brightness=${data.brightness}`);\nif (data.linkquality !== undefined) fields.push(`linkquality=${data.linkquality}`);\n\nconst line = `udendors_lys,sted=${sted} ${fields.join(',')}`;\nconst headers = {\n    'Content-Type': 'text/plain; charset=utf-8',\n    'Authorization': `Token ${env.get('INFLUX_TOKEN')}`\n};\nconst url = 'http://influxdb:8086/api/v2/write?org=energihub&bucket=energi2&precision=s';\n\nconst msgs = [{ url, method: 'POST', headers, payload: line }];\n\nconst key = `lys_sidste_state_${sted}`;\nconst sidste = flow.get(key);\nif (sidste !== stateVal) {\n    flow.set(key, stateVal);\n    const beskrivelse = stateVal ? `${stedNavn} tændt` : `${stedNavn} slukket`;\n    msgs.push({ url, method: 'POST', headers, payload: `events,type=lys_automatik value=\"${beskrivelse}\"` });\n}\n\nreturn [msgs];",
        "outputs": 1,
        "noerr": 0,
        "x": 490,
        "y": 100,
        "wires": [
            [
                "udendors_http"
            ]
        ]
    },
    {
        "id": "udendors_http",
        "type": "http request",
        "z": "udendors_lys_tab",
        "name": "Skriv til InfluxDB",
        "method": "use",
        "ret": "txt",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "x": 740,
        "y": 100,
        "wires": [
            []
        ]
    },
    {
        "id": "depot_sensor_mqtt_in",
        "type": "mqtt in",
        "z": "ced8b8b6adb174ea",
        "name": "Depotsensor bevægelse",
        "topic": "zigbee2mqtt/Depotsensor",
        "qos": "1",
        "datatype": "json",
        "broker": "opvask_mqtt_broker",
        "x": 200,
