    {
        "id": "depot_filter_func",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Kun ved bevægelse",
        "func": "const data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n\nif (data.occupancy === undefined) {\n    return null;\n}\n\n// Kun send videre når der REGISTRERES bevægelse - sensorens egen\n// occupancy:false ignoreres, da vi selv styrer sluk-timeren\nif (data.occupancy === true) {\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "x": 440,
        "y": 580,
        "wires": [
            [
                "depot_trigger"
            ]
        ]
    },
    {
        "id": "depot_trigger",
        "type": "trigger",
        "z": "ced8b8b6adb174ea",
        "name": "Tænd nu, sluk efter 1 min stilhed",
        "op1": "ON",
        "op2": "OFF",
        "op1type": "str",
        "op2type": "str",
        "duration": "60",
        "extend": true,
        "overrideDelay": false,
        "units": "s",
        "reset": "",
        "bytopic": "all",
        "topic": "topic",
        "outputs": 1,
        "x": 680,
        "y": 580,
        "wires": [
            [
                "depot_lys_func"
            ]
        ]
    },
    {
        "id": "depot_lys_func",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Byg lys-kommando",
        "func": "msg.payload = JSON.stringify({ state: msg.payload });\nmsg.topic = 'zigbee2mqtt/Detpotlys/set';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 940,
        "y": 580,
