    {
        "id": "morgen_joke_check",
        "type": "function",
        "z": "sol_lys_tab",
        "name": "Morgen-joke (05:00)",
        "func": "const now = new Date();\nconst nowLocalStr = now.toLocaleString('en-GB', { timeZone: 'Europe/Copenhagen', hour: '2-digit', minute: '2-digit', hour12: false });\nconst [nh, nm] = nowLocalStr.split(':').map(Number);\nconst nowMin = nh * 60 + nm;\n\nconst MORGEN_TIME = 5 * 60 + 0;\n\nconst idagStr = now.toLocaleDateString('en-GB', { timeZone: 'Europe/Copenhagen' });\nconst sidsteDag = flow.get('morgen_joke_sidste_dag');\n\nif (nowMin < MORGEN_TIME || sidsteDag === idagStr) {\n    return null;\n}\n\n// VIGTIGT: markeres IKKE som sendt her - kun efter bekræftet levering\n// (se \"Telegram bekræft\"-noden). Ellers mister vi hele dagens besked\n// permanent hvis der er et forbigående netværksudfald.\n\nconst jokes = [\n    \"Hvorfor tog skelettet ikke til festen? Fordi han ikke havde nogen at ga med! 💀\",\n    \"Hvad sagde den ene vaeg til den anden? Vi modes lige pa hjornet! 🧱\",\n    \"Hvorfor kan cykler ikke sta selv? Fordi de er to-traette! 🚲\",\n    \"Hvad kalder man en ko uden ben? Hakkekod! 🐄\",\n    \"Hvorfor gik computeren til laegen? Den havde en virus! 💻\",\n    \"Hvad siger man til en snegl pa ryggen af en skildpadde? Wheee! 🐌\",\n    \"Hvorfor kan man ikke stole pa atomer? De finder pa alt! ⚛️\",\n    \"Hvad er en pirats yndlingsbogstav? Man skulle tro det var R, men det er faktisk havet! 🏴‍☠️\",\n    \"Hvorfor tog spogelset ikke elevatoren? Den foretrak at ga igennem etagerne! 👻\",\n    \"Hvad sagde 0 til 8? Flot baelte! 🔢\",\n    \"Hvorfor er der ingen der spiller kort i junglen? For mange geparder! 🐆\",\n    \"Hvad kalder man en fisk uden ojne? Fsk! 🐟\",\n    \"Hvorfor blev matematikbogen ked af det? Den havde for mange problemer! 📖\",\n    \"Hvad sagde den ene magnet til den anden? Jeg finder dig tiltraekkende! 🧲\",\n    \"Hvorfor tog bien til laegen? Den havde bi-svarme! 🐝\",\n    \"Hvad er en drages yndlingsmaltid? Grill! 🐉\",\n    \"Hvorfor er skeer altid glade? Fordi de rorer rundt i det hele! 🥄\",\n    \"Hvorfor kunne cyklen ikke sove? Den var for udmattet! 🚴\",\n    \"Hvad kalder man en dinosaur der aldrig giver op? En try-ceratops! 🦖\",\n    \"Hvorfor gik aeblet til laegen? Det folte sig ikke helt frisk! 🍎\",\n    \"Hvad sagde traeet til vinden? Blaes du bare, jeg staer fast! 🌳\",\n    \"Hvorfor tager kartofler aldrig ferie? De er allerede rodfaestede! 🥔\",\n    \"Hvad kalder man en sky der aldrig regner? En optimist! ☁️\",\n    \"Hvorfor kunne blyanten ikke skrive en vits? Den var lidt slov! ✏️\",\n    \"Hvad sagde havet til stranden? Ingenting, det bare vinkede! 🌊\",\n    \"Hvorfor er kaffe altid sa positiv? Den ser altid lyst pa morgenen! ☕\",\n    \"Hvad kalder man en ost der ikke er din egen? Nachos! 🧀\",\n    \"Hvorfor gik toasteren i terapi? Den havde svaert ved at slappe af! 🍞\",\n    \"Hvad sagde den ene stjerne til den anden? Du gor dagen lysere! ⭐\",\n    \"Hvorfor er ure altid traette om morgenen? De har gaet hele natten! ⏰\",\n    \"Hvad kalder man en hund der elsker matematik? En labra-tor! 🐕\",\n    \"Hvorfor tog blomsten en pause? Den havde brug for at rode sig! 🌸\",\n    \"Hvad sagde skyen til regnen? Held og lykke dernede! 🌧️\",\n    \"Hvorfor er broer altid sa afslappede? De haenger bare ud! 🌉\",\n    \"Hvad kalder man en kartoffel der er god til sport? En champion-chip! 🥇\",\n    \"Hvorfor smilede paraplyen? Den sa frem til lidt regn! ☂️\",\n    \"Hvad sagde den ene bolge til den anden? Jeg surfer lige forbi! 🏄\",\n    \"Hvorfor er trapper aldrig ensomme? De har altid trin at holde sig til! 🪜\",\n    \"Hvad kalder man en frosk der parkerer ulovligt? Tudse-bode! 🐸\",\n    \"Hvorfor tog stolen ferie? Den havde brug for at laene sig tilbage! 🪑\",\n    \"Hvad sagde vinduet til solen? Kom bare ind og skin! 🌞\",\n    \"Hvorfor er kalendere altid sa populaere? De har mange dage! 📅\",\n    \"Hvad kalder man en fugl der elsker vinter? En sne-spurv! 🐦\",\n    \"Hvorfor smiler solsikker altid? De folger bare det gode med solen! 🌻\",\n    \"Hvad sagde den ene sok til den anden? Vi er et godt par! 🧦\",\n    \"Hvorfor er postkasser aldrig kede af det? De far altid noget at glaede sig til! 📬\",\n    \"Hvad kalder man en robot der elsker musik? En dans-o-mat! 🤖\",\n    \"Hvorfor gik regnbuen til frisoren? Den ville have nye farver! 🌈\",\n    \"Hvad sagde den ene sky til bjerget? Du raekker virkelig hojt! ⛰️\",\n    \"Hvorfor er senge sa gode til at holde hemmeligheder? De er altid dyner! 🛏️\",\n    \"Hvad kalder man en kop der er god til at fortaelle historier? En kaffekop med indhold! ☕\",\n    \"Hvorfor smiler morgenen altid? Den ved der er en hel ny dag pa vej! 🌅\",\n    \"Hvad sagde den ene fugl til den anden om morgenen? Tidlig fugl fanger ormen, men jeg foretraekker morgenmad! 🐦\",\n    \"Hvorfor er dor-matter sa velkomne overalt? De byder altid folk indenfor! 🚪\",\n    \"Hvad kalder man en sky der er god til comedy? En stand-op-sky! ☁️\",\n    \"Hvorfor tog laderen ferie? Den havde brug for at lade op! 🔌\",\n    \"Hvad sagde den ene time til den anden? Tiden gar hurtigt nar man har det sjovt! ⏳\",\n    \"Hvorfor er glas altid sa positive? De ser altid det halve som fyldt! 🥛\",\n    \"Hvad kalder man en sol der elsker at danse? En solskins-diskofest! ☀️\",\n    \"Hvorfor er morgener bedst med kaffe? Fordi de starter med en varm omfavnelse! ☕\"\n];\n\nlet brugte = flow.get('morgen_joke_brugte') || [];\nlet tilgaengelige = jokes.map((_, i) => i).filter(i => !brugte.includes(i));\n\nif (tilgaengelige.length === 0) {\n    brugte = [];\n    tilgaengelige = jokes.map((_, i) => i);\n}\n\nconst valgtIndex = tilgaengelige[Math.floor(Math.random() * tilgaengelige.length)];\nbrugte.push(valgtIndex);\nflow.set('morgen_joke_brugte', brugte);\n\nconst valgt = jokes[valgtIndex];\nmsg.payload = `☀️ <b>God morgen, Christopher!</b>\\n\\n${valgt}\\n\\nHav en fantastisk dag! 🌞`;\nmsg.kilde = 'morgen_joke';\nmsg.idagStr = idagStr;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 480,
        "y": 220,
        "wires": [
            [
                "telegram-send"
            ]
        ]
    },
    {
        "id": "vidste_du_check",
        "type": "function",
        "z": "sol_lys_tab",
        "name": "Vidste du godt (08-22, hver 2t)",
        "func": "const now = new Date();\nconst nowLocalStr = now.toLocaleString('en-GB', { timeZone: 'Europe/Copenhagen', hour: '2-digit', minute: '2-digit', hour12: false });\nconst [nh, nm] = nowLocalStr.split(':').map(Number);\n\nconst tilladteTimer = [8, 10, 12, 14, 16, 18, 20, 22];\nif (!tilladteTimer.includes(nh)) {\n    return null;\n}\n\nconst idagStr = now.toLocaleDateString('en-GB', { timeZone: 'Europe/Copenhagen' });\nconst slotKey = `${idagStr}_${nh}`;\nconst sidsteSlot = flow.get('fakta_sidste_slot');\nif (sidsteSlot === slotKey) {\n    return null;\n}\n\n// VIGTIGT: markeres IKKE som sendt her - kun efter bekræftet levering\n// (se \"Telegram bekræft\"-noden). Ellers mister vi hele tidsrummets besked\n// permanent hvis der er et forbigående netværksudfald.\n\nconst fakta = [\n    \"en flok flamingoer hedder en 'flamboyance' pa engelsk. 🦩\",\n    \"honning aldrig gar darligt - arkaeologer har fundet 3000 ar gammel honning i egyptiske grave, som stadig var spiselig. 🍯\",\n    \"en gruppe krager hedder en 'murder' pa engelsk, altsa et 'mord af krager'. 🐦‍⬛\",\n    \"octopusser har tre hjerter og blat blod. 🐙\",\n    \"bananer er tekniske baer, mens jordbaer slet ikke er det botanisk set. 🍌\",\n    \"Eiffeltarnet kan blive op til 15 cm hojere om sommeren pga. varmeudvidelse i metallet. 🗼\",\n    \"en dag pa Venus er laengere end et ar pa Venus. ♀️\",\n    \"sommerfugle smager med foddderne. 🦋\",\n    \"det tager lyset fra solen ca. 8 minutter og 20 sekunder at na Jorden. ☀️\",\n    \"hajer eksisterede for dinosaurerne - de har vaeret her i over 400 millioner ar. 🦈\",\n    \"din nese kan huske op til 50.000 forskellige dufte. 👃\",\n    \"Danmark er et af de aeldste kongeriger i verden, med en sammenhaengende kongeraekke tilbage til Gorm den Gamle. 👑\",\n    \"en gruppe pandaer hedder et 'embarrassment' pa engelsk. 🐼\",\n    \"isbjornes pels er faktisk gennemsigtig, ikke hvid - den reflekterer bare lyset. 🐻‍❄️\",\n    \"menneskehjertet slar omkring 100.000 gange om dagen. ❤️\",\n    \"verdens korteste krig varede kun 38 minutter, mellem England og Zanzibar i 1896. ⚔️\",\n    \"en snail kan sove i op til tre ar. 🐌\",\n    \"Mount Everest bliver ved med at vokse ca. 4 mm hvert ar. 🏔️\",\n    \"koldt vand fryser hurtigere end varmt vand under visse forhold - det kaldes Mpemba-effekten. 🧊\",\n    \"der findes flere stjerner i universet end sandkorn pa alle jordens strande tilsammen. ⭐\",\n    \"en gruppe flamingoer star ofte pa et ben for at spare kropsvarme. 🦩\",\n    \"kaenguruer kan ikke ga baglaens. 🦘\",\n    \"Danmark har flere svin end mennesker. 🐖\",\n    \"det menneskelige skelet fornyer sig helt hvert 10. ar. 🦴\",\n    \"en blaehval er sa stor at et menneske kunne krybe gennem dens hovedpulsare. 🐋\",\n    \"morgendug pa graes betyder ofte at det bliver en klar, tor dag. 🌱\",\n    \"Wien i Ostrig er kaldt musikkens hovedstad pga. sin lange historie med komponister som Mozart og Beethoven. 🎻\",\n    \"en gruppe ugler hedder et 'parliament' pa engelsk. 🦉\",\n    \"menneskets ojne kan skelne mellem cirka 10 millioner forskellige farver. 👁️\",\n    \"Sahara-orkenen var engang et frodigt, gront omrade for ca. 6000 ar siden. 🏜️\",\n    \"koral er faktisk levende dyr, ikke planter. 🪸\",\n    \"en dags soevn hjaelper hjernen med at rydde op i unodvendig information fra dagen. 🧠\",\n    \"Danmarks flag, Dannebrog, er et af verdens aeldste stadig brugte nationalflag. 🇩🇰\",\n    \"elefanter kan genkende sig selv i et spejl, hvilket kun fa dyrearter kan. 🐘\",\n    \"det tager cirka 8 ar for lyset fra den naermeste stjerne, Sirius, at na Jorden. ✨\",\n    \"en gruppe delfiner hedder en 'pod'. 🐬\",\n    \"regnbuer er faktisk hele cirkler, men vi ser normalt kun den overste halvdel fra jorden. 🌈\",\n    \"man kan ikke nyse med abne ojne - kroppen lukker dem automatisk. 👀\",\n    \"der findes flere levende organismer i en skefuld jord end mennesker pa hele planeten. 🌍\",\n    \"Great Barrier Reef er den storste levende struktur pa Jorden, synlig fra rummet. 🐠\"\n];\n\nlet brugte = flow.get('fakta_brugte') || [];\nlet tilgaengelige = fakta.map((_, i) => i).filter(i => !brugte.includes(i));\n\nif (tilgaengelige.length === 0) {\n    brugte = [];\n    tilgaengelige = fakta.map((_, i) => i);\n}\n\nconst valgtIndex = tilgaengelige[Math.floor(Math.random() * tilgaengelige.length)];\nbrugte.push(valgtIndex);\nflow.set('fakta_brugte', brugte);\n\nconst valgt = fakta[valgtIndex];\nmsg.payload = `🧠 <b>Vidste du...</b>\\n\\n...at ${valgt}`;\nmsg.kilde = 'vidste_du';\nmsg.slotKey = slotKey;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 480,
        "y": 280,
        "wires": [
            [
                "telegram-send"
            ]
        ]
    },
    {
        "id": "telegram-bekraeft",
        "type": "function",
        "z": "sol_lys_tab",
        "name": "Telegram bekræft levering",
        "func": "// Sætter kun \"sendt\"-flag hvis Telegram bekræfter succesfuld levering.\n// Fanger IKKE andre beskedtyper (Tesla, override, alarm osv.) - de har intet msg.kilde.\nif (!msg.kilde) {\n    return null;\n}\n\nconst success = msg.payload && msg.payload.ok === true;\n\nif (success) {\n    if (msg.kilde === 'morgen_joke' && msg.idagStr) {\n        flow.set('morgen_joke_sidste_dag', msg.idagStr);\n    } else if (msg.kilde === 'vidste_du' && msg.slotKey) {\n        flow.set('fakta_sidste_slot', msg.slotKey);\n    } else if (msg.kilde === 'it_joke' && msg.idagStr) {\n        flow.set('it_joke_sidste_dag', msg.idagStr);\n    } else if (msg.kilde === 'lobe_motivation' && msg.idagStr) {\n        flow.set('lobe_motivation_sidste_dag', msg.idagStr);\n    } else if (msg.kilde === 'uge_status' && msg.idagStr) {\n        flow.set('uge_status_sidste_dag', msg.idagStr);\n    }\n} else {\n    node.warn(`⚠️ Telegram-afsendelse fejlede for '${msg.kilde}' - prøver igen næste tick i stedet for at springe hele perioden over`);\n}\n\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "x": 700,
        "y": 260,
        "wires": [
            []
        ]
    },
    {
        "id": "it_joke_check",
        "type": "function",
        "z": "sol_lys_tab",
        "name": "IT-joke (10:00 hverdage)",
        "func": "const now = new Date();\nconst nowLocalStr = now.toLocaleString('en-GB', { timeZone: 'Europe/Copenhagen', hour: '2-digit', minute: '2-digit', hour12: false });\nconst [nh, nm] = nowLocalStr.split(':').map(Number);\nconst nowMin = nh * 60 + nm;\n\nconst dag = now.getDay(); // 0 = søndag, 6 = lørdag\nconst erHverdag = dag >= 1 && dag <= 5;\n\nconst IT_TIME = 10 * 60 + 0; // 10:00\n\nconst idagStr = now.toLocaleDateString('en-GB', { timeZone: 'Europe/Copenhagen' });\nconst sidsteDag = flow.get('it_joke_sidste_dag');\n\nif (!erHverdag || nowMin < IT_TIME || sidsteDag === idagStr) {\n    return null;\n}\n\nconst jokes = [\n    \"Har du prøvet at slukke og tænde den igen? - Løser 90% af alle IT-supportsager, og 100% af alle joke-opslag om IT-support. 🔌\",\n    \"Der findes 10 slags mennesker: dem der forstår binært, og dem der ikke gør. 💾\",\n    \"En bruger skrev: 'Internettet virker ikke'. Jeg spurgte: 'Har du tjekket kablet?' Svar: 'Hvilket kabel?' 🔌\",\n    \"Hvorfor logger IT-folk aldrig af? Fordi de er bange for at glemme deres eget password. 🔐\",\n    \"Support-billet: 'Skærmen er sort'. Løsning: Tænd skærmen. Sagen lukket. 🖥️\",\n    \"Der er ingen sky - det er bare en andens computer. ☁️\",\n    \"Hvorfor er programmører altid forvirrede over Halloween? Fordi OCT 31 = DEC 25. 🎃\",\n    \"En bruger ringede og sagde 'min mus virker ikke'. Det viste sig at være en fysisk mus i skuffen. 🐭\",\n    \"IT-afdelingens yndlingssætning: 'Det er ikke en fejl, det er en feature'. 🐛\",\n    \"Hvorfor stolede IT-medarbejderen ikke på trapper? For mange steps uden dokumentation. 🪜\",\n    \"Bruger: 'Jeg har slettet en vigtig fil'. IT: 'Har du kigget i papirkurven?' Bruger: 'Hvilken papirkurv?' 🗑️\",\n    \"Der findes ingen dumme spørgsmål i IT-support - kun spørgsmål der allerede står i FAQ'en. 📋\",\n    \"Hvorfor er kaffe IT-afdelingens vigtigste ressource? Fordi 'Have you tried caffeine?' virker lige så ofte som genstart. ☕\",\n    \"Password skal indeholde store bogstaver, tal, specialtegn og et offer fra en drage. Ifølge nogle sikkerhedspolitikker i hvert fald. 🐉\",\n    \"Bruger: 'Systemet er langsomt'. IT: 'Hvor mange faneblade har du åbne?' Bruger: '...47'. 🌐\",\n    \"Den bedste fejlfindingsteknik: gæt, prøv, gentag, og lad som om det var planlagt hele tiden. 🎯\",\n    \"Hvorfor elsker IT-folk mørke temaer? Fordi lyset tiltrækker bugs. 🐞\",\n    \"En bruger spurgte om vi kunne 'sende internettet' til deres printer. Sagen er stadig under efterforskning. 🖨️\",\n    \"IT-support på en søndag: stilhed. IT-support på en mandag kl. 08:01: kaos. 📞\",\n    \"Backup er som flossing - alle ved man skal, næsten ingen gør det før det er for sent. 💾\"\n];\n\nlet brugte = flow.get('it_joke_brugte') || [];\nlet tilgaengelige = jokes.map((_, i) => i).filter(i => !brugte.includes(i));\n\nif (tilgaengelige.length === 0) {\n    brugte = [];\n    tilgaengelige = jokes.map((_, i) => i);\n}\n\nconst valgtIndex = tilgaengelige[Math.floor(Math.random() * tilgaengelige.length)];\nbrugte.push(valgtIndex);\nflow.set('it_joke_brugte', brugte);\n\nconst valgt = jokes[valgtIndex];\nmsg.payload = `💻 <b>IT-pause!</b>\\n\\n${valgt}`;\nmsg.kilde = 'it_joke';\nmsg.idagStr = idagStr;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 480,
        "y": 340,
        "wires": [
            [
                "telegram-send"
            ]
        ]
    },
    {
        "id": "lobe_motivation_check",
        "type": "function",
        "z": "sol_lys_tab",
        "name": "Løbe-motivation (19:00)",
        "func": "const now = new Date();\nconst nowLocalStr = now.toLocaleString('en-GB', { timeZone: 'Europe/Copenhagen', hour: '2-digit', minute: '2-digit', hour12: false });\nconst [nh, nm] = nowLocalStr.split(':').map(Number);\nconst nowMin = nh * 60 + nm;\n\nconst LOEBE_TIME = 19 * 60 + 0; // 19:00\n\nconst idagStr = now.toLocaleDateString('en-GB', { timeZone: 'Europe/Copenhagen' });\nconst sidsteDag = flow.get('lobe_motivation_sidste_dag');\n\nif (nowMin < LOEBE_TIME || sidsteDag === idagStr) {\n    return null;\n}\n\n// Spring over ved kraftig regn/torden - vejrdata opdateres kun kl. 05:50,\n// så denne tjekker samme tekst hele dagen (naturligt \"stille\" på regnvejrsdage)\nconst vejrTekst = (global.get('vejr_tekst') || '').toLowerCase();\nconst daarligtVejr = ['kraftig', 'styrtregn', 'torden'].some(ord => vejrTekst.includes(ord));\nif (daarligtVejr) {\n    return null;\n}\n\n// Nedtælling til Aalborg Marathon, lørdag 15. august 2026 kl. 08:40\nconst maraton = new Date('2026-08-15T08:40:00+02:00');\nconst dageTilbage = Math.ceil((maraton.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));\n\nconst beskeder = [\n    `Sofaen kan vente. Aalborg Marathon kan ikke. ${dageTilbage} dage tilbage - ud og løb en tur! 🏃`,\n    `${dageTilbage} dage til Aalborg. Hver tur tæller nu. Skoene venter ved døren. 👟`,\n    `Sommerens aftener er lavet til at løbe i. ${dageTilbage} dage til maraton - kom så! 🌅`,\n    `Ingen løber maraton på viljestyrke alene den 15. august. Byg formen nu - ${dageTilbage} dage tilbage. 💪`,\n    `Det er ikke for sent at komme ud i aften. ${dageTilbage} dage til Aalborg venter ikke på dig. 🏃‍♂️`,\n    `Tænk på målstregen i Aalborg. ${dageTilbage} dage. En tur i aften bringer dig tættere på. 🎯`,\n    `De bedste maratonløbere er dem der løb, selv når de ikke havde lyst. ${dageTilbage} dage tilbage. 🏅`,\n    `Aftenluften er perfekt til en løbetur lige nu. ${dageTilbage} dage til Aalborg Marathon. 🌆`,\n    `Hver kilometer i aften er en investering i den 15. august. ${dageTilbage} dage tilbage. 📈`,\n    `Ud af døren, ind i skoene. ${dageTilbage} dage til Aalborg - kroppen skal være klar. 🔥`,\n    `Sommeraftenen bliver ikke længere - men formen kan blive bedre. ${dageTilbage} dage tilbage. ☀️`,\n    `Du lovede dig selv Aalborg Marathon. ${dageTilbage} dage tilbage til at holde det løfte. 🤝`,\n    `En kort tur er bedre end ingen tur. ${dageTilbage} dage til maraton - af sted! 🚀`,\n    `Kl. 08:40 den 15. august starter du i Aalborg. ${dageTilbage} dage til at forberede benene. 🦵`,\n    `Aftenens løbetur er en investering, ikke en pligt. ${dageTilbage} dage tilbage til Aalborg. 💙`\n];\n\nconst valgt = beskeder[Math.floor(Math.random() * beskeder.length)];\nmsg.payload = `🏃 <b>Løbetid!</b>\\n\\n${valgt}`;\nmsg.kilde = 'lobe_motivation';\nmsg.idagStr = idagStr;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 480,
        "y": 400,
        "wires": [
            [
                "telegram-send"
            ]
        ]
    },
    {
        "id": "uge_status_check",
        "type": "function",
        "z": "sol_lys_tab",
        "name": "Ugentlig status: tidstjek",
        "func": "const now = new Date();\nconst nowLocalStr = now.toLocaleString('en-GB', { timeZone: 'Europe/Copenhagen', hour: '2-digit', minute: '2-digit', hour12: false });\nconst [nh, nm] = nowLocalStr.split(':').map(Number);\nconst nowMin = nh * 60 + nm;\n\nconst dag = now.getDay(); // 0 = søndag\nconst STATUS_TIME = 20 * 60 + 0; // 20:00\n\nconst idagStr = now.toLocaleDateString('en-GB', { timeZone: 'Europe/Copenhagen' });\nconst sidsteDag = flow.get('uge_status_sidste_dag');\n\nif (dag !== 0 || nowMin < STATUS_TIME || sidsteDag === idagStr) {\n    return null;\n}\n\nmsg.url = 'http://dashboard:3000/api/statistik-periode?periode=maaned';\nmsg.method = 'GET';\nmsg.idagStr = idagStr;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 480,
        "y": 460,
        "wires": [
            [
                "uge_status_hent"
