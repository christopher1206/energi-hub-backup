    {
        "id": "naeste-begivenhed-api",
        "type": "http in",
        "z": "f8fcc2eca1886938",
        "name": "Næste begivenhed",
        "url": "/api/begivenheder",
        "method": "get",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 190,
        "y": 380,
        "wires": [
            [
                "naeste-begivenhed-handler"
            ]
        ]
    },
    {
        "id": "naeste-begivenhed-handler",
        "type": "function",
        "z": "f8fcc2eca1886938",
        "name": "Byg begivenheder",
        "func": "const nu = new Date();\nconst time = nu.getHours();\nconst min = nu.getMinutes();\nconst soc = global.get('batteri_soc') || 0;\n\n// Beregn næste begivenhed\nlet naeste = [];\n\n// Næste discharge skift\nif (time >= 6 && time < 16) {\n    const diff = 16 - time;\n    naeste.push({ \n        tid: '16:00', \n        besked: '🔋 Dyre timer starter - discharge 100%', \n        minutter: diff * 60 - min \n    });\n} else if (time >= 16 && time < 22) {\n    const diff = 22 - time;\n    naeste.push({ \n        tid: '22:00', \n        besked: '🌙 Nat - discharge 100% fortsætter til 06:00', \n        minutter: diff * 60 - min \n    });\n} else {\n    // Nat 22-06\n    const minutterTil06 = time >= 22 \n        ? (24 - time + 6) * 60 - min \n        : (6 - time) * 60 - min;\n    naeste.push({ \n        tid: '06:00', \n        besked: '☀️ Dag mode - discharge 0% (sol lader batteri)', \n        minutter: minutterTil06\n    });\n}\n\n// Batteri advarsel\nif (soc <= 15) {\n    naeste.unshift({ \n        tid: 'NU', \n        besked: `⚠️ Batteri lavt (${soc}%) - stopper afladning ved 10%`, \n        minutter: 0 \n    });\n}\n\n// Tesla ladning - bruger den FAKTISKE ladeplan fra Beslutnings-motor\n// (samme datakilde som Ladeplan-kortet på dashboardet), i stedet for en\n// separat genberegning der kunne komme ud af trit med den ægte beslutning.\nconst ladeplan = global.get('ladeplan');\nconst carSoc = global.get('car_soc') || 50;\nconst goECar = global.get('go_e_car') || 1;\nconst teslaLaderNu = global.get('tesla_lad') || false;\n\nif (goECar > 1 && teslaLaderNu) {\n    naeste.push({ \n        tid: 'NU', \n        besked: `🚗 Tesla lader (${carSoc}% → 100%)`, \n        minutter: 0 \n    });\n} else if (goECar > 1 && ladeplan && ladeplan.timer && ladeplan.timer.length > 0) {\n    const foerste = ladeplan.timer[0];\n    const startTid = new Date(foerste.time);\n    if (startTid > nu) {\n        const fmt = (d) => d.toLocaleTimeString('da-DK', { hour: '2-digit', minute: '2-digit' });\n        naeste.push({ \n            tid: fmt(startTid), \n            besked: `🚗 Tesla starter ladning (${carSoc}% → 100%)`, \n            minutter: Math.round((startTid.getTime() - nu.getTime()) / 60000) \n        });\n    }\n}\n\n// Sidst udført\nconst sidst = [\n    { \n        tid: nu.toLocaleTimeString('da-DK', { hour: '2-digit', minute: '2-digit' }), \n        besked: `⚡ Discharge: ${global.get('discharge_rate') || 0}% | Mode: ${global.get('growatt_kommando') || 'Load first'} | Batteri: ${soc}%` \n    },\n];\n\nmsg.payload = { naeste, sidst };\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 380,
        "wires": [
