    {
        "id": "60b252ae4d437c93",
        "type": "function",
        "z": "sol_lys_tab",
        "name": "Beregn ønsket lys-status",
        "func": "const lat = 55.48375;\nconst lon = 9.299174;\nconst now = new Date();\n\nfunction calcSunUTC(date, lat, lon, isSunrise) {\n    const rad = Math.PI / 180;\n    const zenith = 90.833;\n    const N1 = Math.floor(275 * (date.getUTCMonth()+1) / 9);\n    const N2 = Math.floor((date.getUTCMonth()+1 + 9) / 12);\n    const N3 = (1 + Math.floor((date.getUTCFullYear() - 4 * Math.floor(date.getUTCFullYear() / 4) + 2) / 3));\n    const N = N1 - (N2 * N3) + date.getUTCDate() - 30;\n    const lngHour = lon / 15;\n    const t = isSunrise ? N + ((6 - lngHour) / 24) : N + ((18 - lngHour) / 24);\n    const M = (0.9856 * t) - 3.289;\n    let L = M + (1.916 * Math.sin(M * rad)) + (0.020 * Math.sin(2 * M * rad)) + 282.634;\n    L = (L + 360) % 360;\n    let RA = (1/rad) * Math.atan(0.91764 * Math.tan(L * rad));\n    RA = (RA + 360) % 360;\n    const Lquadrant = Math.floor(L / 90) * 90;\n    const RAquadrant = Math.floor(RA / 90) * 90;\n    RA = (RA + (Lquadrant - RAquadrant)) / 15;\n    const sinDec = 0.39782 * Math.sin(L * rad);\n    const cosDec = Math.cos(Math.asin(sinDec));\n    const cosH = (Math.cos(zenith * rad) - (sinDec * Math.sin(lat * rad))) / (cosDec * Math.cos(lat * rad));\n    if (cosH > 1 || cosH < -1) return null;\n    let H = isSunrise ? 360 - (1/rad) * Math.acos(cosH) : (1/rad) * Math.acos(cosH);\n    H = H / 15;\n    const T = H + RA - (0.06571 * t) - 6.622;\n    let UT = ((T - lngHour) + 24) % 24;\n    return UT;\n}\n\nfunction utcHoursToLocalMinutes(utcHours, baseDate) {\n    if (utcHours === null) return null;\n    const h = Math.floor(utcHours);\n    const m = Math.round((utcHours - h) * 60);\n    const d = new Date(Date.UTC(baseDate.getUTCFullYear(), baseDate.getUTCMonth(), baseDate.getUTCDate(), h, m, 0));\n    const localStr = d.toLocaleString('en-GB', { timeZone: 'Europe/Copenhagen', hour: '2-digit', minute: '2-digit', hour12: false });\n    const [lh, lm] = localStr.split(':').map(Number);\n    return lh * 60 + lm;\n}\n\nconst sunriseUTC = calcSunUTC(now, lat, lon, true);\nconst sunsetUTC = calcSunUTC(now, lat, lon, false);\nconst sunriseMin = utcHoursToLocalMinutes(sunriseUTC, now);\nconst sunsetMin = utcHoursToLocalMinutes(sunsetUTC, now);\n\nif (sunriseMin === null || sunsetMin === null) {\n    node.warn('Kunne ikke beregne solopgang/solnedgang - ingen ændring');\n    return [null, null];\n}\n\nconst nowLocalStr = now.toLocaleString('en-GB', { timeZone: 'Europe/Copenhagen', hour: '2-digit', minute: '2-digit', hour12: false });\nconst [nh, nm] = nowLocalStr.split(':').map(Number);\nconst nowMin = nh * 60 + nm;\n\nconst morningOnMin = 5 * 60 + 30;\nconst curfewOffMin = 23 * 60 + 58;\n\nlet onsket = false;\nlet reason = '';\n\nif (nowMin < morningOnMin) {\n    onsket = false;\n    reason = 'nat (efter 23:58)';\n} else if (nowMin < sunriseMin) {\n    onsket = true;\n    reason = '05:30 (før solopgang)';\n} else if (nowMin < sunsetMin) {\n    onsket = false;\n    reason = 'solopgang';\n} else if (nowMin < curfewOffMin) {\n    onsket = true;\n    reason = 'solnedgang';\n} else {\n    onsket = false;\n    reason = '23:58 (nat-stop)';\n}\n\nconst key = 'lys_udendors_state';\nconst sidste = flow.get(key);\n\nconst sunriseStr = `${Math.floor(sunriseMin/60)}:${String(sunriseMin%60).padStart(2,'0')}`;\nconst sunsetStr = `${Math.floor(sunsetMin/60)}:${String(sunsetMin%60).padStart(2,'0')}`;\n\nnode.status({fill: onsket ? 'green' : 'grey', shape: 'dot', text: `${onsket ? 'TÆNDT' : 'SLUKKET'} (sol: ${sunriseStr}-${sunsetStr})`});\n\nflow.set('lys_sol_tider', { sunrise: sunriseStr, sunset: sunsetStr });\n\nif (sidste !== onsket) {\n    flow.set(key, onsket);\n    const state = onsket ? 'ON' : 'OFF';\n\n    const mqttMsgs = [\n        { topic: 'zigbee2mqtt/lys_carport/set', payload: JSON.stringify({ state }) },\n        { topic: 'zigbee2mqtt/lys_terrasse/set', payload: JSON.stringify({ state }) }\n    ];\n\n    const beskrivelse = `${onsket ? '💡 Udendørs lys tændt' : '🌑 Udendørs lys slukket'} automatisk (${reason})`;\n    const escaped = beskrivelse.replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"');\n    const line = `events,type=lys_automatik value=\"${escaped}\"`;\n\n    const eventMsg = {\n        url: 'http://influxdb:8086/api/v2/write?org=energihub&bucket=energi2&precision=s',\n        method: 'POST',\n        headers: {\n            'Content-Type': 'text/plain; charset=utf-8',\n            'Authorization': `Token ${env.get('INFLUX_TOKEN')}`\n        },\n        payload: line\n    };\n\n    return [mqttMsgs, eventMsg];\n}\n\nreturn [null, null];",
