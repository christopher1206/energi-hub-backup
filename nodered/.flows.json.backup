    {
        "id": "bil-soc-status-handler",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Bil SOC status",
        "func": "const gemtSoc = global.get('car_soc') || 50;\nconst opdateret = global.get('car_soc_opdateret') || null;\nconst akkumuleret = global.get('car_charged_wh_akkumuleret') || 0;\n\nconst beregnetSoc = Math.min(100, Math.round(gemtSoc + (akkumuleret / 600)));\n\nnode.warn(`Bil SOC: gemt=${gemtSoc}% + akkumuleret=${akkumuleret.toFixed(0)}Wh = beregnet=${beregnetSoc}%`);\n\nmsg.payload = { \n    soc: beregnetSoc, \n    opdateret,\n    gemt_soc: gemtSoc,\n    tilfoejt_kwh: parseFloat((akkumuleret / 1000).toFixed(2))\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 200,
