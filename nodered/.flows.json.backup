    {
        "id": "alarm-check",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Alarm check",
        "func": "const soc = global.get('batteri_soc') || 0;\nconst sol = global.get('sol_power') || 0;\n\nconst beskeder = [];\nconst events = [];\n\n// Batteri status: LAVT / FULDT / NORMAL - kun besked ved SKIFT\nlet batteriStatus = 'normal';\nif (soc <= 15) batteriStatus = 'lavt';\nelse if (soc >= 95) batteriStatus = 'fuldt';\n\nconst sidsteBatteriStatus = global.get('alarm_batteri_status') || 'normal';\n\nif (batteriStatus !== sidsteBatteriStatus) {\n    if (batteriStatus === 'lavt') {\n        beskeder.push(`⚠️ Growatt batteri LAVT: ${soc}%`);\n        events.push({ payload: { event: 'alarm', beskrivelse: `⚠️ Growatt batteri lavt: ${soc}%` } });\n    } else if (batteriStatus === 'fuldt') {\n        beskeder.push(`✅ Growatt batteri FULDT: ${soc}% - Klar til dyre timer!`);\n        events.push({ payload: { event: 'alarm', beskrivelse: `✅ Growatt batteri fuldt: ${soc}%` } });\n    } else if (sidsteBatteriStatus === 'lavt') {\n        beskeder.push(`🔋 Growatt batteri normaliseret: ${soc}%`);\n    }\n    global.set('alarm_batteri_status', batteriStatus);\n}\n\n// Høj sol produktion - kun ved overgang til høj\nconst solHoej = sol > 5000;\nconst sidsteSolHoej = global.get('alarm_sol_hoej_status') || false;\nif (solHoej && !sidsteSolHoej) {\n    beskeder.push(`☀️ Høj sol produktion: ${sol}W!`);\n    events.push({ payload: { event: 'alarm', beskrivelse: `☀️ Høj sol produktion: ${sol}W` } });\n}\nglobal.set('alarm_sol_hoej_status', solHoej);\n\nconst msg1 = beskeder.length > 0 ? { payload: beskeder.join('\\n') } : null;\nconst msg2 = events.length > 0 ? events : null;\n\nreturn [msg1, msg2];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 190,
        "y": 380,
        "wires": [
            [
                "telegram-send"
            ],
            [
                "event-link-out"
            ]
        ]
    },
