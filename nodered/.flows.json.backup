    {
        "id": "tg_http_get",
        "type": "http request",
        "z": "ced8b8b6adb174ea",
        "name": "Telegram getUpdates",
        "method": "GET",
        "ret": "obj",
        "url": "https://api.telegram.org/bot8716129124:AAHP0rg0PFAEISe0Ml_KyW-AfrykHt_kEKQ/getUpdates?offset={{{payload.offset}}}&timeout=0",
        "x": 180,
        "y": 500,
        "wires": [
            [
                "tg_parse"
            ]
        ]
    },
    {
        "id": "tg_parse",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Parse Telegram besked",
        "func": "const result = msg.payload;\n\n// Stop hvis ingen nye beskeder\nif (!result || !result.ok || !result.result || result.result.length === 0) {\n    return [null, null];\n}\n\nfor (const update of result.result) {\n    const newOffset = update.update_id + 1;\n    const currentOffset = global.get('tg_offset') || 0;\n    if (newOffset > currentOffset) {\n        global.set('tg_offset', newOffset);\n    }\n\n    const text = update.message ? update.message.text : null;\n    const chatId = update.message ? update.message.chat.id : null;\n\n    if (!text) continue;\n\n    const tekstLower = text.trim().toLowerCase();\n\n    // Kommando: \"køkken\" - svar med seneste temperatur/luftfugtighed\n    if (tekstLower === 'køkken' || tekstLower === 'kokken') {\n        const data = global.get('koekken_seneste');\n        let svar;\n        if (data && data.temperature !== undefined) {\n            const tidStr = new Date(data.opdateret).toLocaleTimeString('da-DK', { hour: '2-digit', minute: '2-digit' });\n            svar = `🌡️ <b>Køkken lige nu</b>\\n\\n${data.temperature.toFixed(1)}°C · ${data.humidity !== undefined ? data.humidity.toFixed(0) + '% luftfugtighed' : ''}`;\n            if (data.battery !== undefined) {\n                svar += `\\n🔋 Batteri: ${data.battery}%`;\n            }\n            svar += `\\n\\nSidst opdateret: ${tidStr}`;\n        } else {\n            svar = '🌡️ Ingen data fra køkken-sensoren endnu.';\n        }\n        return [null, { payload: svar }];\n    }\n\n    // Tjek om det er et tal (bil SOC)\n    const trimmed = text.trim().replace('%', '');\n    const soc = parseFloat(trimmed);\n\n    if (!isNaN(soc) && soc >= 0 && soc <= 100) {\n        return [{ payload: { soc: Math.round(soc), chatId } }, null];\n    }\n}\n\n// Ingen gyldige kommandoer fundet\nreturn [null, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 500,
        "wires": [
            [
                "tg_gem_soc"
            ],
            [
                "telegram-send"
            ]
        ]
    },
    {
        "id": "tg_gem_soc",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Gem SOC og svar",
        "func": "const soc = msg.payload.soc;\nconst chatId = msg.payload.chatId;\n\nglobal.set('car_soc', soc);\nglobal.set('car_soc_opdateret', new Date().toISOString());\nglobal.set('car_charged_wh_akkumuleret', 0);\n\nnode.warn('🚗 Telegram: Bil SOC opdateret til ' + soc + '%');\n\nconst priser = global.get('priser') || [];\nconst nuT = new Date();\nconst TESLA_KWH = 60;\nconst TESLA_MAX_KW = 11;\nconst DEADLINE_TIME = 6;\nconst manglerKwh = Math.max(0, (100 - soc) * (TESLA_KWH / 100));\nconst timerNodvendige = Math.ceil(manglerKwh / TESLA_MAX_KW);\n\nconst deadline = new Date(nuT);\ndeadline.setHours(DEADLINE_TIME, 0, 0, 0);\nif (deadline <= nuT) deadline.setDate(deadline.getDate() + 1);\n\nconst kommendeTilPlan = priser.filter(p => {\n    const t = new Date(p.time);\n    return t > nuT && t <= deadline;\n});\n\nconst billigstePlan = [...kommendeTilPlan]\n    .sort((a, b) => a.pris - b.pris)\n    .slice(0, timerNodvendige)\n    .sort((a, b) => new Date(a.time) - new Date(b.time));\n\nlet planBeskrivelse;\nif (manglerKwh === 0) {\n    planBeskrivelse = `📋 Ladeplan: Bil allerede fuldt opladet (${soc}%)`;\n} else if (billigstePlan.length > 0) {\n    const startTid = new Date(billigstePlan[0].time).toLocaleTimeString('da-DK', {hour:'2-digit', minute:'2-digit'});\n    const slutTid = new Date(new Date(billigstePlan[billigstePlan.length-1].time).getTime() + 3600000).toLocaleTimeString('da-DK', {hour:'2-digit', minute:'2-digit'});\n    const snit = (billigstePlan.reduce((a,b) => a + b.pris, 0) / billigstePlan.length).toFixed(2);\n    planBeskrivelse = `📋 Ladeplan: ${startTid}-${slutTid} (${timerNodvendige}t, snit ${snit} kr/kWh) for at nå 100% fra ${soc}%`;\n} else {\n    planBeskrivelse = `📋 Ladeplan: Ingen billige timer fundet inden ${DEADLINE_TIME}:00 (mangler ${manglerKwh.toFixed(0)} kWh fra ${soc}%)`;\n}\n\nconst eventMsg = { payload: { event: 'tesla_plan', beskrivelse: planBeskrivelse } };\n\nconst token = '8716129124:AAHP0rg0PFAEISe0Ml_KyW-AfrykHt_kEKQ';\nconst svar = '✅ Bil SOC opdateret til ' + soc + '%\\n\\n' + planBeskrivelse;\n\nconst svarMsg = { url: 'https://api.telegram.org/bot' + token + '/sendMessage', payload: { chat_id: chatId, text: svar } };\nreturn [svarMsg, eventMsg];",
        "outputs": 2,
        "x": 850,
        "y": 40,
        "wires": [
            [
                "tg_svar_api"
            ],
            [
                "event-link-out"
            ]
        ]
    },
