    {
        "id": "d02da5e2c9b27efd",
        "type": "function",
        "z": "f8fcc2eca1886938",
        "name": "convert",
        "func": "// Sikker JSON parsing - undgår crash hvis API svarer med fejltekst i stedet for JSON\ntry {\n    msg.payload = JSON.parse(msg.payload);\n} catch (e) {\n    node.warn(`⏳ Priser ikke klar endnu (${msg.dag || 'ukendt'}) - API svar: \"${msg.payload}\"`);\n    return null; // stop stille her, prøv igen ved næste times-inject\n}\nreturn msg;",
