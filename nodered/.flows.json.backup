    {
        "id": "bil-soc-api",
        "type": "http in",
        "z": "ced8b8b6adb174ea",
        "name": "Sæt bil SOC",
        "url": "/api/bil/soc",
        "method": "post",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 150,
        "y": 140,
        "wires": [
            [
                "bil-soc-handler"
            ]
        ]
    },
    {
        "id": "bil-soc-handler",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Gem bil SOC",
        "func": "const soc = parseFloat(msg.payload.soc);\nif (isNaN(soc) || soc < 0 || soc > 100) {\n    msg.payload = { success: false, besked: 'Ugyldig SOC værdi' };\n    return [msg, null];\n}\nglobal.set('car_soc', soc);\nglobal.set('car_soc_opdateret', new Date().toISOString());\nglobal.set('car_charged_wh_akkumuleret', 0);\nnode.warn(`🚗 Bil SOC sat til: ${soc}% (akkumulering nulstillet)`);\n\nconst priser = global.get('priser') || [];\nconst nuT = new Date();\nconst TESLA_KWH = 60;\nconst TESLA_MAX_KW = 11;\nconst DEADLINE_TIME = 6;\nconst manglerKwh = Math.max(0, (100 - soc) * (TESLA_KWH / 100));\nconst timerNodvendige = Math.ceil(manglerKwh / TESLA_MAX_KW);\n\nconst deadline = new Date(nuT);\ndeadline.setHours(DEADLINE_TIME, 0, 0, 0);\nif (deadline <= nuT) deadline.setDate(deadline.getDate() + 1);\n\nconst kommendeTilPlan = priser.filter(p => {\n    const t = new Date(p.time);\n    return t > nuT && t <= deadline;\n});\n\nconst billigstePlan = [...kommendeTilPlan]\n    .sort((a, b) => a.pris - b.pris)\n    .slice(0, timerNodvendige)\n    .sort((a, b) => new Date(a.time) - new Date(b.time));\n\nlet planBeskrivelse;\nif (manglerKwh === 0) {\n    planBeskrivelse = `📋 Ladeplan: Bil allerede fuldt opladet (${soc}%)`;\n} else if (billigstePlan.length > 0) {\n    const startTid = new Date(billigstePlan[0].time).toLocaleTimeString('da-DK', {hour:'2-digit', minute:'2-digit'});\n    const slutTid = new Date(new Date(billigstePlan[billigstePlan.length-1].time).getTime() + 3600000).toLocaleTimeString('da-DK', {hour:'2-digit', minute:'2-digit'});\n    const snit = (billigstePlan.reduce((a,b) => a + b.pris, 0) / billigstePlan.length).toFixed(2);\n    planBeskrivelse = `📋 Ladeplan: ${startTid}-${slutTid} (${timerNodvendige}t, snit ${snit} kr/kWh) for at nå 100% fra ${soc}%`;\n} else {\n    planBeskrivelse = `📋 Ladeplan: Ingen billige timer fundet inden ${DEADLINE_TIME}:00 (mangler ${manglerKwh.toFixed(0)} kWh fra ${soc}%)`;\n}\n\nconst eventMsg = { payload: { event: 'tesla_plan', beskrivelse: planBeskrivelse } };\nmsg.payload = { success: true, soc, besked: `Bil SOC sat til ${soc}%` };\nreturn [msg, eventMsg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 140,
        "wires": [
            [
                "bil-soc-svar"
            ],
            [
                "event-link-out"
            ]
        ]
    },
    {
        "id": "bil-soc-svar",
        "type": "http response",
        "z": "ced8b8b6adb174ea",
        "name": "Bil SOC svar",
        "statusCode": "200",
        "headers": {
            "Content-Type": "application/json"
        },
        "x": 650,
        "y": 140,
        "wires": []
    },
    {
