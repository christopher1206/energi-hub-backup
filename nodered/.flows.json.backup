    {
        "id": "opvask_function",
        "type": "function",
        "z": "opvask_tab",
        "name": "Byg InfluxDB line protocol",
        "func": "const data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n\nif (data.apower === undefined) {\n    return null;\n}\n\nconst fields = [];\nfields.push(`apower=${data.apower}`);\nif (data.voltage !== undefined) fields.push(`voltage=${data.voltage}`);\nif (data.current !== undefined) fields.push(`current=${data.current}`);\nif (data.output !== undefined) fields.push(`output=${data.output ? 1 : 0}`);\nif (data.aenergy && data.aenergy.total !== undefined) fields.push(`aenergy_total=${data.aenergy.total}`);\nif (data.temperature && data.temperature.tC !== undefined) fields.push(`temp_c=${data.temperature.tC}`);\n\nconst line = `opvaskemaskine ${fields.join(',')}`;\nconst headers = {\n    'Content-Type': 'text/plain; charset=utf-8',\n    'Authorization': `Token ${env.get('INFLUX_TOKEN')}`\n};\nconst url = 'http://influxdb:8086/api/v2/write?org=energihub&bucket=energi2&precision=s';\n\nconst msgs = [{ url, method: 'POST', headers, payload: line }];\n\nif (data.output !== undefined) {\n    const sidste = flow.get('opvask_sidste_output');\n    if (sidste !== data.output) {\n        flow.set('opvask_sidste_output', data.output);\n        const beskrivelse = data.output ? 'Opvaskemaskine tændt' : 'Opvaskemaskine slukket';\n        msgs.push({ url, method: 'POST', headers, payload: `events,type=opvaskemaskine value=\"${beskrivelse}\"` });\n    }\n}\n\nreturn [msgs];",
        "outputs": 1,
        "noerr": 0,
        "x": 480,
        "y": 100,
        "wires": [
            [
                "opvask_http"
            ]
        ]
    },
