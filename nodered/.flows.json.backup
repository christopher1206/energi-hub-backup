    {
        "id": "depot_lys_status_in",
        "type": "mqtt in",
        "z": "ced8b8b6adb174ea",
        "name": "Depotlys status",
        "topic": "zigbee2mqtt/Detpotlys",
        "qos": "1",
        "datatype": "json",
        "broker": "opvask_mqtt_broker",
        "x": 200,
        "y": 660,
        "wires": [
            [
                "depot_status_func"
            ]
        ]
    },
    {
        "id": "depot_status_func",
        "type": "function",
        "z": "ced8b8b6adb174ea",
        "name": "Byg InfluxDB + log hændelse",
        "func": "const data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n\nif (data.state === undefined) {\n    return null;\n}\n\nconst stateVal = data.state === 'ON' ? 1 : 0;\n\n// Gem seneste tilstand globalt til dashboard-API\nglobal.set('depot_lys_state', {\n    state: data.state,\n    linkquality: data.linkquality,\n    opdateret: new Date().toISOString()\n});\n\nconst fields = [`state=${stateVal}`];\nif (data.linkquality !== undefined) fields.push(`linkquality=${data.linkquality}`);\n\nconst line = `depot_lys ${fields.join(',')}`;\nconst headers = {\n    'Content-Type': 'text/plain; charset=utf-8',\n    'Authorization': `Token ${env.get('INFLUX_TOKEN')}`\n};\nconst url = 'http://influxdb:8086/api/v2/write?org=energihub&bucket=energi2&precision=s';\n\nconst msgs = [{ url, method: 'POST', headers, payload: line }];\n\n// Log hændelse kun ved faktisk skift\nconst key = 'depot_lys_sidste_state';\nconst sidste = flow.get(key);\nif (sidste !== stateVal) {\n    flow.set(key, stateVal);\n    const beskrivelse = stateVal ? 'Depotlys tændt (bevægelse)' : 'Depotlys slukket (ingen bevægelse i 1 min)';\n    msgs.push({ url, method: 'POST', headers, payload: `events,type=depot_lys value=\"${beskrivelse}\"` });\n}\n\nreturn [msgs];",
        "outputs": 1,
        "noerr": 0,
        "x": 440,
        "y": 660,
        "wires": [
            [
                "depot_influx_write"
            ]
        ]
    },
