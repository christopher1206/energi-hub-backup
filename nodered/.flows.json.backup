    {
        "id": "hent-vejr",
        "type": "http request",
        "z": "f8fcc2eca1886938",
        "name": "Hent vejr",
        "method": "GET",
        "ret": "obj",
        "url": "https://api.openweathermap.org/data/2.5/forecast?lat=55.48375&lon=9.299174&appid=1908e24a2653afbea4a5cb4b403385e6&units=metric&lang=da&cnt=8",
        "x": 200,
        "y": 520,
        "wires": [
            [
                "gem-vejr"
            ]
        ]
    },
    {
        "id": "gem-vejr",
        "type": "function",
        "z": "f8fcc2eca1886938",
        "name": "Gem vejr data",
        "func": "const list = msg.payload.list || [];\nconst dagensTimer = list.slice(0, 4);\n\nconst maxTemp = Math.max(...dagensTimer.map(t => t.main.temp_max));\nconst minTemp = Math.min(...dagensTimer.map(t => t.main.temp_min));\nconst vejrTekst = dagensTimer[0]?.weather[0]?.description || 'ukendt';\nconst skyer = Math.round(dagensTimer.reduce((sum, t) => sum + t.clouds.all, 0) / dagensTimer.length);\nconst solPotentiale = skyer < 30 ? '☀️ Højt solpotentiale' : skyer < 70 ? '⛅ Moderat solpotentiale' : '☁️ Lavt solpotentiale';\n\nglobal.set('vejr_temp_max', Math.round(maxTemp));\nglobal.set('vejr_temp_min', Math.round(minTemp));\nglobal.set('vejr_tekst', vejrTekst);\nglobal.set('vejr_skyer', skyer);\nglobal.set('vejr_sol_potentiale', solPotentiale);\n\nnode.warn(`🌤️ Vejr Lunderskov: ${vejrTekst}, ${Math.round(minTemp)}-${Math.round(maxTemp)}°C, ${skyer}% skyer`);\nreturn null;",
        "outputs": 1,
        "x": 450,
        "y": 520,
        "wires": [
            []
        ]
    },
